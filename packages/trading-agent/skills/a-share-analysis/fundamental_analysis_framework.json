{
  "framework_name": "公司基本面分析框架",
  "description": "涵盖成长性、财务健康、风险控制三个维度，以「应用指标 × 通用算子」形式组织",
  "version": "1.0",
  "dimensions": [
    {
      "dimension_name": "成长性",
      "description": "衡量公司规模扩张、增长质量和可持续性",
      "indicators": [
        {
          "metric": "营业收入",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)", "N年平均值"],
          "insight": "公司整体规模是否在扩大？"
        },
        {
          "metric": "各业务线/产品收入",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)"],
          "insight": "哪块业务是增长引擎？"
        },
        {
          "metric": "经销商家数/门店数",
          "operators": ["同比增长率", "环比增长率"],
          "insight": "渠道网络是否在有效扩张？"
        },
        {
          "metric": "单店收入/单经销商收入",
          "operators": ["同比增长率", "环比增长率"],
          "insight": "存量渠道的内生增长能力如何？"
        },
        {
          "metric": "合同负债（预收账款）",
          "operators": ["同比增长率", "环比增长率"],
          "insight": "下游订单是否充沛？是未来收入的先行指标"
        },
        {
          "metric": "新签订单金额",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)"],
          "insight": "适用于工程、软件、装备制造等行业"
        },
        {
          "metric": "净利润",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)", "N年平均值"],
          "insight": "公司最终赚到的钱是否在增加？"
        },
        {
          "metric": "扣非净利润",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)"],
          "insight": "剔除一次性损益后，主业利润是否在增长？"
        },
        {
          "metric": "经营性现金流净额",
          "operators": ["同比增长率", "环比增长率", "复合年增长率(CAGR)"],
          "insight": "利润增长是否带来了真金白银？"
        },
        {
          "metric": "自由现金流",
          "operators": ["同比增长率", "复合年增长率(CAGR)"],
          "insight": "可自由支配的现金是否在增加？"
        },
        {
          "metric": "净资产收益率（ROE）",
          "operators": ["同比变化（百分点）"],
          "insight": "股东资本的赚钱效率是在提升还是下降？"
        },
        {
          "metric": "研发费用",
          "operators": ["同比增长率", "复合年增长率(CAGR)"],
          "insight": "为未来技术/产品储备的投入是否在持续增加？"
        },
        {
          "metric": "资本支出",
          "operators": ["同比增长率", "复合年增长率(CAGR)"],
          "insight": "产能扩张的投入是否在加大？"
        },
        {
          "metric": "人均创收",
          "operators": ["同比增长率", "环比增长率"],
          "insight": "人效是否在提升？"
        },
        {
          "metric": "人均创利",
          "operators": ["同比增长率", "环比增长率"],
          "insight": "人均利润贡献是否在提升？"
        }
      ]
    },
    {
      "dimension_name": "财务健康",
      "description": "衡量公司偿债能力、流动性、现金安全和资本结构稳健性",
      "indicators": [
        {
          "metric": "资产负债率",
          "operators": ["同比增减（百分点）", "绝对值判断"],
          "insight": "整体杠杆水平是否合理？通常50%-60%为警戒线，需结合行业"
        },
        {
          "metric": "流动比率",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "流动资产是否足以覆盖流动负债？通常>1.5较安全"
        },
        {
          "metric": "速动比率",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "剔除存货后，短期偿债能力是否充足？通常>1较安全"
        },
        {
          "metric": "利息保障倍数",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "经营利润是否足够支付利息？通常>2较安全"
        },
        {
          "metric": "经营性现金流/有息负债",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "现金流对刚性债务的实际覆盖能力如何？比率越高越安全"
        },
        {
          "metric": "净现比（经营现金流/净利润）",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "利润的现金含量是否健康？通常>0.8为良好，>1为优秀"
        },
        {
          "metric": "收现比（销售商品收到现金/营收）",
          "operators": ["同比变化", "绝对值判断"],
          "insight": "营业收入的回款质量如何？通常>0.9为良好，>1为优秀"
        },
        {
          "metric": "自由现金流",
          "operators": ["正值/负值判断", "同比变化"],
          "insight": "是否持续为正？持续负值可能意味着依赖外部融资"
        },
        {
          "metric": "货币资金/有息负债",
          "operators": ["绝对值判断", "同比变化"],
          "insight": "在手现金是否能覆盖短期刚性债务？比率<0.3需警惕"
        },
        {
          "metric": "股东权益比率",
          "operators": ["同比增减（百分点）", "绝对值判断"],
          "insight": "自有资本占比是否稳定？与资产负债率互补，通常>50%较稳健"
        }
      ]
    },
    {
      "dimension_name": "风险控制",
      "description": "识别运营、回款、存货、流动性等潜在风险信号",
      "indicators": [
        {
          "metric": "现金转换周期",
          "operators": ["同比延长/缩短（天数）", "绝对值判断"],
          "insight": "资金被占用的周期是否在变长？周期越长，运营资金压力越大"
        },
        {
          "metric": "应收账款周转天数",
          "operators": ["同比延长/缩短（天数）", "绝对值判断"],
          "insight": "回款是否在变慢？天数异常增加可能预示坏账风险或放松信用政策"
        },
        {
          "metric": "存货周转天数",
          "operators": ["同比延长/缩短（天数）", "绝对值判断"],
          "insight": "产品是否在滞销？天数异常增加可能预示跌价风险"
        },
        {
          "metric": "资本支出/营收比率",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "过高可能挤压现金流，过低可能影响未来竞争力"
        },
        {
          "metric": "研发费用率",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "投入是否不足？持续过低可能导致产品/技术落后"
        },
        {
          "metric": "有息负债/总资产",
          "operators": ["同比增减（百分点）", "绝对值判断"],
          "insight": "高成本负债占比是否在攀升？比率过高会增加财务费用和违约风险"
        },
        {
          "metric": "短期借款/有息负债",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "债务结构是否短长合理？短期债务占比过高会带来再融资风险"
        },
        {
          "metric": "大客户依赖度（前五大客户收入占比）",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "是否过度依赖少数客户？占比>30%需警惕客户流失风险"
        },
        {
          "metric": "关联交易占比",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "是否存在利益输送风险？占比过高且定价不透明需警惕"
        },
        {
          "metric": "商誉/净资产",
          "operators": ["同比变化（百分点）", "绝对值判断"],
          "insight": "是否存在商誉减值风险？占比>30%且被收购方业绩下滑需警惕"
        }
      ]
    }
  ]
}